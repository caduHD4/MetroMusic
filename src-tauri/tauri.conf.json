{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetroMusic",
  "version": "0.1.5",
  "identifier": "dev.caduhd4.metromusic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MetroMusic",
        "width": 1360,
        "height": 860,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/**",
          "$APPLOCALDATA/covers/**",
          "$APPDATA/images/**",
          "$APPLOCALDATA/images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "Player de música desktop com várias fontes, letras sincronizadas e Discord",
    "longDescription": "MetroMusic reúne YouTube Music, SoundCloud e Spotify em um player de desktop feito com Tauri, Rust e React."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3M0Y0ODgxMjlCMjZCNkMKUldSc2E3SXBnVWcvQnk5bmRQTkw5UVovMVU3Mk9LaXdWVDYrL0x4T2tnTzlHbWFoYjlUMEZWT3YK",
      "endpoints": [
        "https://github.com/caduHD4/MetroMusic/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
